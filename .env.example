POSTGRES_DB=medisync
POSTGRES_USER=medisync_bootstrap
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgresql+asyncpg://medisync_runtime:replace-with-runtime-url-safe-password@db:5432/medisync
MIGRATION_DATABASE_URL=postgresql+asyncpg://medisync_migrator:replace-with-migration-url-safe-password@db:5432/medisync
CLEANUP_DATABASE_URL=postgresql+asyncpg://medisync_cleanup:replace-with-cleanup-url-safe-password@db:5432/medisync
DATABASE_SSL_MODE=prefer
PGSSLROOTCERT=
APP_ENV=development
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:8000
AI_PROVIDER=local_rules
AI_PATIENT_DATA_ENABLED=false
AI_EXTERNAL_CALLS_ENABLED=false
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=512
AI_CONTEXT_MAX_MESSAGES=12
AI_CONTEXT_MAX_CHARS=6000
AI_CONVERSATION_RETENTION_DAYS=90
AI_ANALYTICS_RETENTION_DAYS=365
OPERATOR_AUDIT_RETENTION_DAYS=365
# Vercel-only settings are configured in the Vercel project, not Docker Compose:
# CRON_SECRET=<random header-safe value of at least 16 characters>
